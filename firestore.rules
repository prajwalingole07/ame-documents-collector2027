rules_version = '2';

// ADMISSIONS MADE EASY, LATUR - Student Document Portal 2027
//
// These rules keep the portal working on the Firebase free (Spark) plan.
// All app data is stored in Cloud Firestore so that every phone / PC sees
// the same records in real time. File contents are stored as chunked binary
// documents (see src/firebase/fileStore.js).
//
// IMPORTANT: The free plan does not include Firebase Authentication or
// Firebase Storage. The rules below therefore allow access to the named
// collections only. For a production deployment with sensitive documents,
// upgrade the Firebase project to Blaze, enable Authentication + Storage,
// and replace these rules with authenticated rules. See README.md.
service cloud.firestore {
  match /databases/{database}/documents {
    // Student accounts
    match /students/{regNo} {
      allow read, write: if request.time < timestamp.date(2028, 12, 31);
    }

    // One document per student containing all document metadata
    match /student_documents/{regNo} {
      allow read, write: if request.time < timestamp.date(2028, 12, 31);
    }

    // Binary file chunks used by the free-plan file store
    match /document_files/{fileId} {
      allow read, write: if request.time < timestamp.date(2028, 12, 31);

      match /chunks/{chunkId} {
        allow read, write: if request.time < timestamp.date(2028, 12, 31);
      }
    }

    // Admin credentials (SHA-256 hash only)
    match /admin_config/{docId} {
      allow read, write: if request.time < timestamp.date(2028, 12, 31);
    }

    // Optional counters / audit trail
    match /counters/{docId} {
      allow read, write: if request.time < timestamp.date(2028, 12, 31);
    }
    match /audit_logs/{docId} {
      allow read, write: if request.time < timestamp.date(2028, 12, 31);
    }
  }
}
